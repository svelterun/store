# [Choice] Debian OS version: bullseye, buster
ARG VARIANT=bullseye
FROM --platform=linux/amd64 mcr.microsoft.com/vscode/devcontainers/base:0-${VARIANT}

# update system packages and cleanup cache
ARG DEBIAN_FRONTEND=noninteractive

ARG USER=vscode

# install deno
ENV DENO_INSTALL=/usr/local
RUN /bin/bash -c "$(curl -fsSL https://deno.land/install.sh)" \
    && chown ${USER:-vscode} /usr/local/bin/deno

RUN sudo apt-get -y update \
    && sudo apt-get -y install --no-install-recommends gcc git-extras \
    && sudo apt-get -y upgrade && sudo rm -rf /var/lib/apt/lists/*

# add some extensions to the bottom of the .bashrc file, to ensure homebrew is
# configured correctly, install the starship CLI (if needed), and configure its
# preset configuration if none is defined yet. also adds a couple aliases.
RUN echo '# autogenerated by dockerfile, do not edit\n\n'\
         'export DENO_INSTALL=/usr/local; export DENO_INSTALL_ROOT=/usr/local/bin; '\
         'test -d "$DENO_INSTALL" || sudo mkdir -p "$DENO_INSTALL"; '\
         'if ! which deno &>/dev/null; then '\
            'curl -fsSL https://deno.land/install.sh | sudo -EnsHb; '\
         'fi;'\
         'export HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/home/linuxbrew/.linuxbrew}";'\
         'if ! command -v "$HOMEBREW_PREFIX/bin/brew" &>/dev/null; then '\
            '/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)";'\
         'fi;'\
         'eval "$($HOMEBREW_PREFIX/bin/brew shellenv)";'\
         'command -v starship &>/dev/null || brew install starship &>/dev/null;'\
         'eval "$(starship init bash)";'\
         'test -d "$HOME/.config" || mkdir -p "$HOME/.config";'\
         'if ! test -f "$HOME/.config/starship.toml"; then'\
            'starship preset -o "$HOME/.config/starship.toml" gruvbox-rainbow;'\
         'fi;'\
         'alias ll="ls -AlhFo --color=auto --si --group-directories-first --time-style=long-iso --file-type";'\
         'alias dq="deno repl -qA --v8-flags=--expose-gc,--harmony";'\
         'export LS_COLORS="di=1;34:ln=1;36:so=1;35:pi=1;33:ex=1;32:bd=1;34:cd=1;34:su=1;41:sg=1;46:tw=1;42:ow=1;43";'\
        >> ${HOME-}/.bashrc

RUN sudo mkdir -p /etc/bash_completion.d && deno completions bash > /etc/bash_completion.d/deno.bash
